# Base de datos SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_INSTANCE=
DB_DRIVER=
DB_TRUSTED_CONNECTION=false
DB_NAME=bloomskin
DB_USER=sa
DB_PASSWORD=tu_password_aqui
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# JWT
JWT_SECRET=cambia_esto_por_una_clave_muy_secreta_y_larga
JWT_EXPIRES_IN=8h

# Servidor
PORT=3000
NODE_ENV=development

# CORS
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,https://tu-frontend.com

# Persistencia de archivos y settings
DATA_DIR=
SITE_SETTINGS_FILE=
UPLOADS_DIR=

# Email / Newsletter SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Datos para transferencia manual
BANK_NAME=
BANK_ACCOUNT_TYPE=
BANK_ACCOUNT_NUMBER=
BANK_ACCOUNT_HOLDER=
BANK_ACCOUNT_RUT=
BANK_TRANSFER_EMAIL=
BANK_TRANSFER_INSTRUCTIONS=

# Google Maps para geocodificar direcciones de envio
# Esta key se usa desde el backend para Geocoding API.
# No sirve una key restringida solo por HTTP referrers.
# Usa una key sin restricciones durante desarrollo o restringida por IP para produccion.
GOOGLE_MAPS_API_KEY=

# OpenAI Vision para sugerir datos de productos desde una foto en admin
OPENAI_API_KEY=
OPENAI_PRODUCT_VISION_MODEL=gpt-4o-mini

# Flow: mantener desactivado hasta configurar credenciales y probar sandbox.
FLOW_ENABLED=false
FLOW_ENV=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=
STORE_BASE_URL=https://bloomskin.cl

# Solo para el script aislado qa-flow-sandbox.js. No activan Sandbox en la tienda.
FLOW_SANDBOX_API_KEY=
FLOW_SANDBOX_SECRET_KEY=
# Opcional: correo propio para pagos de prueba (por defecto usa SMTP_FROM).
FLOW_SANDBOX_TEST_EMAIL=
